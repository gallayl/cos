{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "paths": {
      "@cos/ui": ["../frontend/src/cos-sdk/modules/ui.d.ts"],
      "@cos/net": ["../frontend/src/cos-sdk/modules/net.d.ts"],
      "@cos/network": ["../frontend/src/cos-sdk/modules/net.d.ts"],
      "@cos/fs": ["../frontend/src/cos-sdk/modules/fs.d.ts"],
      "@cos/filesystem": ["../frontend/src/cos-sdk/modules/fs.d.ts"],
      "@cos/console": ["../frontend/src/cos-sdk/modules/console.d.ts"],
      "@cos/json": ["../frontend/src/cos-sdk/modules/json.d.ts"],
      "@cos/string": ["../frontend/src/cos-sdk/modules/string.d.ts"],
      "@cos/math": ["../frontend/src/cos-sdk/modules/math.d.ts"],
      "@cos/gc": ["../frontend/src/cos-sdk/modules/gc.d.ts"],
      "@cos/global": ["../frontend/src/cos-sdk/modules/global.d.ts"],
      "@cos/introspect": ["../frontend/src/cos-sdk/modules/introspect.d.ts"],
      "@berry/*": ["../frontend/src/cos-sdk/modules/*"]
    },
    "strict": true,
    "noLib": true,
    "noEmit": true,
    "types": [],
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["ts/**/*.ts", "../frontend/src/cos-sdk/**/*.d.ts"]
}
