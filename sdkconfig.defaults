# COS sdkconfig defaults
# Only non-default settings are listed here.
# Run `idf.py menuconfig` to customize, or `idf.py build` to generate full sdkconfig.

# Target
CONFIG_IDF_TARGET="esp32"

# Flash (CYD board has 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# Bluetooth (BLE only, Bluedroid stack, HID Host via GATT)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTC_CONNECT_RETRY_COUNT=3

# WiFi: move hot-path functions from IRAM to flash (frees ~17KB IRAM for BT coexistence)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_ICMP=y

# Compiler: no C++ exceptions, no RTTI (save flash/RAM)
# CONFIG_COMPILER_CXX_EXCEPTIONS is not set
# CONFIG_COMPILER_CXX_RTTI is not set

# SPI flash: Boya chip support + yield during erase to prevent WDT
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_SPI_FLASH_YIELD_DURING_ERASE=y
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=20
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=1

# Enable ANSI color codes in ESP_LOGx output
CONFIG_LOG_COLORS=y

# HTTP server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# HTTPS client used by net.fetch (memory-constrained ESP32).
# Keep certificate verification enabled (bundle attached in network_http.c).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Reduce fixed TLS I/O buffers: default 16KB in / 4KB out caused
# mbedtls_ssl_setup alloc failures (MBEDTLS_ERR_SSL_ALLOC_FAILED, -0x008D)
# on ~18KB free-heap boots. 4KB/4KB is a compatibility/memory tradeoff;
# variable buffer + max fragment length let negotiated buffers shrink.
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_MAX_FRAGMENT_LENGTH=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Prefer dynamic TLS buffers where supported by ESP-IDF/mbedTLS config.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# Partition table (custom: factory + LittleFS)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LittleFS: pet task watchdog during flash operations (avoids TWDT resets on slow ops)
CONFIG_LITTLEFS_WDT_RESET=y
